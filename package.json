{
  "name": "rehabex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-development-environment.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:env:safety": "node scripts/check-development-environment.mjs",
    "test:admin:safety": "tsx --test tests/admin/safetyFoundation.test.ts && node --test tests/admin/environmentSafety.test.mjs",
    "test:admin:boundary": "tsx --test tests/admin/adminValidators.test.ts tests/admin/adminBoundary.contract.test.ts tests/admin/adminRouteDispatch.contract.test.ts",
    "test:admin:media": "tsx --test tests/admin/mediaValidators.test.ts tests/admin/mediaBoundary.contract.test.ts",
    "test:admin:concurrency": "tsx --test tests/db/adminBoundaryConcurrency.test.ts",
    "test:api": "tsx --test tests/api/commerce.contract.test.ts tests/api/paymentRecovery.contract.test.ts",
    "test:cart": "tsx --test tests/cart/cartState.test.ts tests/ui/paymentPresentation.test.ts",
    "test:db:concurrency": "tsx --test tests/db/paymentAtomicConcurrency.test.ts",
    "check:api": "tsc -p tsconfig.api.json && tsc -p tsconfig.vercel-api.json"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.103.3",
    "cloudinary": "^2.11.0",
    "lucide-react": "^1.47.0",
    "mercadopago": "^2.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
