# Required whenever development uses Supabase. Accepted values: local, staging.
# Development deliberately refuses "production" and unclassified remote data.
REHABEX_DATA_ENV=local
VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_ANON_KEY=

# Serverless/backend only. These are deliberately false placeholders, never values.
# Keep all Mercado Pago secrets out of VITE_ variables and out of Git.
# Mercado Pago's own environment, deliberately independent from VERCEL_ENV:
# Rehabex runs on Vercel Production while Mercado Pago is still in test.
# Required. Checkout fails closed when it is unset or unrecognised.
MERCADOPAGO_ENV=test
MERCADOPAGO_ACCESS_TOKEN=REPLACE_IN_HOST_ONLY
MERCADOPAGO_WEBHOOK_SECRET=REPLACE_IN_HOST_ONLY
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_HOST_ONLY
# Same anon key as VITE_SUPABASE_ANON_KEY, kept as a separate server-only
# variable. The admin API uses it to call admin RPCs as the caller's own
# authenticated user (so auth.uid() resolves inside SECURITY DEFINER
# functions), never with the service role key.
SUPABASE_ANON_KEY=
COMMERCE_RATE_LIMIT_HASH_SECRET=REPLACE_IN_HOST_ONLY
# Server-only. CLOUDINARY_API_SECRET must never be exposed to the browser and
# must never gain a VITE_ prefix. The panel only ever receives short-lived
# signed upload parameters computed from these, never the secret itself.
# No unsigned upload preset is configured or accepted.
CLOUDINARY_CLOUD_NAME=REPLACE_IN_HOST_ONLY
CLOUDINARY_API_KEY=REPLACE_IN_HOST_ONLY
CLOUDINARY_API_SECRET=REPLACE_IN_HOST_ONLY
PUBLIC_SITE_URL=https://example.invalid
# The signed webhook URL is configured in Mercado Pago > Tus integraciones only.
# It is never sent as notification_url, so the app no longer reads MERCADOPAGO_WEBHOOK_URL.
ALLOWED_ORIGINS=https://example.invalid
